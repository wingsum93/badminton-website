{
  "name": "badminton-coaching-website",
  "version": "0.0.1",
  "private": true,
  "description": "Cantonese badminton coaching website with Tailwind CSS and Nginx Docker hosting.",
  "scripts": {
    "build": "npm run build:html && npm run build:css",
    "build:sites": "npm run build && node scripts/build-sites.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "build:html": "node scripts/build-html.mjs",
    "check": "node scripts/check-links.mjs",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
